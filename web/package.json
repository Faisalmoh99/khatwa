{
  "name": "khatwa-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Khatwa: foot temperature monitoring app for people with diabetes (MEDATHON 2026)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p netlify/tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"netlify/**/*.mts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"netlify/**/*.mts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "icons": "node scripts/gen-icons.mjs",
    "postbuild": "node scripts/copy-legacy.mjs",
    "check:device": "node scripts/check-device.mjs",
    "test:rules": "cd .. && firebase emulators:exec --only database --project demo-khatwa \"node web/scripts/test-rules.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@netlify/blobs": "^11.1.8",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "lucide-react": "^1.70.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@netlify/functions": "^6.1.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-serial": "^1.0.9",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "~3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
